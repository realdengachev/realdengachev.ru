---
import { ui, site } from '../data/content';

const dict = {
  theme: { label: ui.theme.label, names: ui.theme.names },
  language: { label: ui.language.label, names: ui.language.names },
  title: site.title,
  titleRu: site.titleRu,
};
---

<div class="controls" role="group" aria-label="Preferences" data-controls>
  <button class="ctl" type="button" id="lang-btn" data-ctl="language" aria-label="Language: English. Switch to Russian">
    <span class="ctl__icon">
      <svg id="lang-icon" class="ctl__svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" aria-hidden="true">
        <circle cx="8" cy="8" r="6.4"></circle>
        <path d="M1.6 8h12.8"></path>
        <path d="M8 1.6c1.9 1.8 2.9 4 2.9 6.4S9.9 12.6 8 14.4C6.1 12.6 5.1 10.4 5.1 8S6.1 3.4 8 1.6Z"></path>
      </svg>
    </span>
    <span class="ctl__label" aria-hidden="true" data-label>English</span>
  </button>
  <button class="ctl" type="button" id="theme-btn" data-ctl="theme" aria-label="Theme: Light. Switch to dark">
    <span class="ctl__icon">
      <svg id="theme-icon" class="ctl__svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M6.04458 1.60806C6.1589 1.35528 6.10472 1.05812 5.90855 0.861947C5.71237 0.665775 5.41522 0.611597 5.16244 0.725914C2.51258 1.92428 0.666626 4.59176 0.666626 7.69181C0.666626 11.9121 4.08786 15.3334 8.30817 15.3334C11.4082 15.3334 14.0757 13.4874 15.2741 10.8375C15.3884 10.5848 15.3342 10.2876 15.138 10.0914C14.9419 9.89526 14.6447 9.84108 14.3919 9.9554C13.6009 10.3131 12.7225 10.5126 11.7956 10.5126C8.31168 10.5126 5.4874 7.6883 5.4874 4.20438C5.4874 3.27752 5.68686 2.39905 6.04458 1.60806Z"
          fill="currentColor"></path>
      </svg>
    </span>
    <span class="ctl__label" aria-hidden="true" data-label>Light</span>
  </button>
  <script type="application/json" data-ctl-dict set:html={JSON.stringify(dict)} />
</div>

<style>
  .controls {
    position: absolute; top: max(12px, env(safe-area-inset-top)); right: max(var(--page-pad), calc((100% - var(--content-w)) / 2)); z-index: 5;
    display: flex; gap: 8px;
  }
  .ctl {
    --w-open: 96px;
    display: flex; align-items: center; flex: none;
    width: 32px; height: 32px; padding: 0 0 0 8px; border: 0; border-radius: 10px; overflow: hidden;
    background: var(--ctl-bg); color: var(--color-text); cursor: pointer;
    transition: width 0.65s var(--ease-smooth), background-color 0.35s var(--ease-out);
  }
  .ctl:hover, .ctl:focus-visible { width: var(--w-open); background: var(--ctl-bg-hover); }
  .ctl:focus-visible { outline: 1px solid var(--color-text); outline-offset: 2px; }
  .ctl:active { background: var(--ctl-bg-hover); }

  .ctl__icon { display: grid; place-items: center; flex: none; width: 16px; height: 16px; }
  .ctl__svg { width: 16px; height: 16px; transform-origin: center; transition: opacity 0.5s, transform 0.5s; }
  .ctl__svg:global(.morph-out) { opacity: 0; transform: scale(0.85) rotate(30deg); }

  .ctl__label {
    margin-left: 6px; white-space: nowrap;
    font: 400 12px / 1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.02em;
    opacity: 0; filter: blur(4px); transform: translate3d(-6px, 0, 0);
    transition: opacity 0.22s var(--ease-out), filter 0.3s var(--ease-out), transform 0.4s var(--ease-smooth);
  }
  .ctl:hover .ctl__label, .ctl:focus-visible .ctl__label {
    opacity: 1; filter: blur(0); transform: none;
    transition: opacity 0.4s var(--ease-out) 0.12s, filter 0.5s var(--ease-out) 0.1s, transform 0.6s var(--ease-smooth) 0.08s;
  }
  .ctl__label:global(.is-swap) { opacity: 0 !important; filter: blur(3px) !important; transition-duration: 0.12s !important; transition-delay: 0s !important; }

  /* мобильный: подпись не выдвигается — иконка просто переключает значение */
  @media (hover: none), (max-width: 767px) {
    .ctl:hover, .ctl:focus-visible { width: 32px; }
    .ctl__label { display: none; }
  }
  /* тач: увеличиваем кнопки до 40px (зона нажатия), подпись не раскрываем */
  @media (pointer: coarse) {
    .ctl, .ctl:hover, .ctl:focus-visible { width: 40px; height: 40px; padding-left: 12px; }
    .controls { gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ctl, .ctl__label, .ctl__svg { transition: none !important; }
  }
</style>
