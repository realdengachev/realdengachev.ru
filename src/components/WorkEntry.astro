---
import { Image } from 'astro:assets';
import type { WorkEntry } from '../data/content';
import T from './T.astro';
import deeepMark from '../assets/img/deeep-mark.png';
import { ext } from '../data/links';

interface Props {
  entry: WorkEntry;
}
const { entry } = Astro.props;
---

<div class="entry">
  <div class="entry__head">
    <div class="entry__logo" style={`border-radius:${entry.logoRadius}px`} aria-hidden="true">
      {
        entry.logo === 'deeep' ? (
          <div class="entry__deeep">
            <div class="entry__deeep-a"><Image src={deeepMark} alt="" width={160} format="webp" /></div>
            <div class="entry__deeep-b"><Image src={deeepMark} alt="" width={160} format="webp" /></div>
          </div>
        ) : (
          <Image src={entry.logo} alt="" width={64} height={64} quality={90} format="webp" />
        )
      }
    </div>
    <p class="entry__title">
      <a class="link entry__name" href={entry.href} {...ext}><T l={entry.name} /></a>{entry.suffix && <> <span class="entry__suffix"><T l={entry.suffix} /></span></>}
    </p>
    {
      entry.badge && (
        <>
          <span class="entry__sep" aria-hidden="true">|</span>
          <span class="badge">
            <i class="badge__laurel" aria-hidden="true" />
            <span class="badge__text">
              <span data-l="en">{entry.badge.en.map((t, i) => (<>{i > 0 && <br />}{t}</>))}</span>
              <span data-l="ru">{entry.badge.ru.map((t, i) => (<>{i > 0 && <br />}{t}</>))}</span>
            </span>
            <i class="badge__laurel badge__laurel--r" aria-hidden="true" />
          </span>
        </>
      )
    }
  </div>
  <p class:list={['entry__desc', { 'entry__desc--tight': entry.tightLeading }]} style={entry.maxWidth ? `--mw:${entry.maxWidth}px;--mw-ru:${entry.maxWidthRu ?? entry.maxWidth}px` : undefined}>
    {
      entry.description.map((line, i) => (
        <>
          {i > 0 && line.en && <br class="br-d" data-l="en" />}
          {i > 0 && line.ru && <br class="br-d" data-l="ru" />}
          <T l={line} />
        </>
      ))
    }
  </p>
</div>

<style>
  .entry { display: flex; flex-direction: column; gap: var(--gap-12); }
  .entry__head { display: flex; align-items: center; gap: 10px; }
  .entry__logo { position: relative; flex: none; width: 32px; height: 32px; overflow: hidden; background: #000; }
  .entry__logo:has(> img) { background: transparent; }
  .entry__logo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .entry__title { font-size: var(--fs-16); line-height: var(--lh-140); white-space: nowrap; }
  .entry__name { font-size: var(--fs-16); line-height: var(--lh-140); }
  .entry__suffix { color: var(--color-muted); }
  .entry__sep { font-size: var(--fs-16); line-height: var(--lh-140); color: var(--color-muted); }
  .entry__desc { max-width: var(--mw, none); font-size: var(--fs-16); line-height: var(--lh-150); color: var(--color-muted); }

  .badge { display: flex; align-items: center; gap: 4px; color: #caa016; }
  .badge__text { font-size: 12px; line-height: 1.1; text-align: center; white-space: nowrap; }
  .badge__laurel {
    display: block; flex: none; width: 15.6px; height: 26px; background: #caa016;
    -webkit-mask: url('/img/laurel.png') 0 0.65px / 13.65px 26px no-repeat;
    mask: url('/img/laurel.png') 0 0.65px / 13.65px 26px no-repeat;
  }
  .badge__laurel--r { transform: scaleX(-1); -webkit-mask-position: 1.95px 0.65px; mask-position: 1.95px 0.65px; }

  /* составной знак Deeep.app: два кропа вордмарка на тёмном круге (как в Figma 98:189) */
  .entry__deeep { position: absolute; inset: 0; background: #060606; }
  .entry__deeep-a, .entry__deeep-b { position: absolute; overflow: hidden; }
  .entry__deeep-a { left: 6px; top: 16.15px; width: 14.135px; height: 6.682px; }
  .entry__deeep-b { left: 6px; top: 9.5px; width: 20px; height: 6.5px; }
  .entry__deeep-a :global(img) { position: absolute; max-width: none; width: 270.91%; height: 161.54%; left: -160%; top: -30.77%; }
  .entry__deeep-b :global(img) { position: absolute; max-width: none; width: 186.25%; height: 161.54%; left: -10%; top: -30.77%; }
  :global(html[data-lang='ru']) .entry__desc { max-width: var(--mw-ru, var(--mw, none)); }
  .entry__desc--tight { line-height: var(--lh-140); text-wrap: wrap; } /* без балансировки — слова заполняют первую строку */
</style>
